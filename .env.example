# Operations Under Pressure — Environment Variable Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.

# ─── PostgreSQL Database ─────────────────────────────────────────────────────
# Full JDBC connection URL to your PostgreSQL database.
# Example (local): jdbc:postgresql://localhost:5432/operations
# Example (Railway): provided in your Railway project dashboard
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/operations

# PostgreSQL credentials
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# In development the Vite proxy forwards /api/* to localhost:8080 automatically.
# For production deployments set this to your deployed backend base URL.
# Leave unset if using the default proxy configuration.
# VITE_API_BASE_URL=https://your-backend.up.railway.app
